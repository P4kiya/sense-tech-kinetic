{
  "expo": {
    "name": "SENSE-TECH Kinetic",
    "slug": "sense-tech-kinetic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sensetech.kinetic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F6F8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sensetech.kinetic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#4F6BED"
        }
      ]
    ]
  }
}
